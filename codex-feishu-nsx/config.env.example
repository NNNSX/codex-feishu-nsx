# codex-feishu-nsx configuration
# Copy to ~/.codex-feishu-nsx/config.env

# Use an absolute path for the host OS, for example C:\workspace\project or /Users/me/workspace.
CFN_DEFAULT_WORKDIR=/path/to/workspace
# CFN_DEFAULT_MODEL=
CFN_DEFAULT_MODE=code
# CFN_ATTACHMENT_RETENTION_DAYS=30

CFN_FEISHU_APP_ID=your-app-id
CFN_FEISHU_APP_SECRET=your-app-secret
CFN_FEISHU_DOMAIN=https://open.feishu.cn
# CFN_FEISHU_ALLOWED_USERS=ou_user_1,ou_user_2

# Optional Codex authentication when `codex auth login` is not used.
# CFN_CODEX_API_KEY=
# CFN_CODEX_BASE_URL=
# CFN_CODEX_SKIP_GIT_REPO_CHECK=true
# CFN_CODEX_SANDBOX_MODE=workspace-write
# CFN_CODEX_PASS_MODEL=true
