{
  "name": "codex-feishu-nsx",
  "version": "1.1.0",
  "description": "Bridge a local Codex session to Feishu/Lark",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/main.ts",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test --test-concurrency=1 --import tsx --test-timeout=15000 src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.110.0",
    "codex-feishu-nsx-core": "file:../codex-feishu-nsx-core"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
